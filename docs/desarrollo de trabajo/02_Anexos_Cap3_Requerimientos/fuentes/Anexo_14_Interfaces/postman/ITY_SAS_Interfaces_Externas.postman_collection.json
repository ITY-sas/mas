{
  "info": {
    "name": "ITY SAS - Sistema Multiagente (Colección de Interfaces Externas)",
    "_postman_id": "7b89f81a-4d2c-4b61-9c1a-7b3b4f91e920",
    "description": "Colección completa de peticiones de prueba y contratos para las 10 interfaces externas del Sistema Multiagente de ITY SAS, incluyendo las operaciones de Postiz para ambos agentes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Agente de Ideación y Estrategia",
      "item": [
        {
          "name": "IE-01: TikTok Research - Consultar Tendencias de Video",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tiktok_access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": {\n    \"and\": [\n      {\n        \"operation\": \"IN\",\n        \"field_name\": \"hashtag_name\",\n        \"field_values\": [\n          \"skincarecolombia\",\n          \"cuidadodelapiel\"\n        ]\n      },\n      {\n        \"operation\": \"EQ\",\n        \"field_name\": \"region_code\",\n        \"field_values\": [\n          \"CO\"\n        ]\n      }\n    ]\n  },\n  \"start_date\": \"20260801\",\n  \"end_date\": \"20260828\",\n  \"max_count\": 20\n}"
            },
            "url": {
              "raw": "https://open.tiktokapis.com/v2/research/video/query/",
              "protocol": "https",
              "host": [
                "open",
                "tiktokapis",
                "com"
              ],
              "path": [
                "v2",
                "research",
                "video",
                "query",
                ""
              ]
            }
          }
        },
        {
          "name": "IE-02: Instagram Graph - Métricas Históricas de Cuenta",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instagram_access_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "https://graph.facebook.com/v21.0/{{instagram_account_id}}/insights?metric=reach,impressions,profile_views&period=day",
              "protocol": "https",
              "host": [
                "graph",
                "facebook",
                "com"
              ],
              "path": [
                "v21.0",
                "{{instagram_account_id}}",
                "insights"
              ],
              "query": [
                {
                  "key": "metric",
                  "value": "reach,impressions,profile_views"
                },
                {
                  "key": "period",
                  "value": "day"
                }
              ]
            }
          }
        },
        {
          "name": "IE-04: LLM Gateway - Extracción Semántica y Validación de Brief",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Analiza el siguiente texto de brief y extrae los campos obligatorios: cliente, objetivo, audiencia, formato, tono y palabras clave. Texto: 'Campa\\u00f1a de verano para Amatu, promocionando el s\\u00e9rum bot\\u00e1nico para mujeres de 25 a 40 a\\u00f1os interesadas en cosm\\u00e9tica limpia.'\",\n  \"system\": \"Eres un asistente de planificaci\\u00f3n de marketing digital de ITY SAS. Extrae y valida la informaci\\u00f3n en JSON estricto.\",\n  \"model\": \"llama3:8b\",\n  \"temperature\": 0.2\n}"
            },
            "url": {
              "raw": "{{llm_gateway_url}}/v1/generate",
              "host": [
                "{{llm_gateway_url}}"
              ],
              "path": [
                "v1",
                "generate"
              ]
            }
          }
        },
        {
          "name": "Postiz (Para Ideación): Consultar Canales Activos de la Marca",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{postiz_api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{postiz_api_url}}/integrations",
              "host": [
                "{{postiz_api_url}}"
              ],
              "path": [
                "integrations"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Agente de Publicación y Scheduling",
      "item": [
        {
          "name": "IE-04: LLM Gateway - Adaptación de Variantes de Copy Multicanal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Genera 3 variantes de copy adaptadas por canal para el post de verano Amatu. Formatos: Instagram (gancho + emoji + CTA bio), TikTok (hook directo + trending), LinkedIn (enfoque dermatol\\u00f3gico formal).\",\n  \"system\": \"Experto en copywriting multicanal.\",\n  \"model\": \"llama3:8b\",\n  \"temperature\": 0.7\n}"
            },
            "url": {
              "raw": "{{llm_gateway_url}}/v1/generate",
              "host": [
                "{{llm_gateway_url}}"
              ],
              "path": [
                "v1",
                "generate"
              ]
            }
          }
        },
        {
          "name": "Postiz (Para Publicación): Programar Post Multicanal con Variantes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{postiz_api_key}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Nuevo s\\u00e9rum bot\\u00e1nico Amatu: hidrataci\\u00f3n profunda sin qu\\u00edmicos t\\u00f3xicos.\",\n  \"integration_ids\": [\n    \"int_inst_9921\",\n    \"int_tt_4412\",\n    \"int_li_1102\"\n  ],\n  \"contents\": {\n    \"instagram\": \"\\ud83c\\udf3f \\u00bfTu piel sufre por el sol de verano? Descubre el s\\u00e9rum bot\\u00e1nico de Amatu con extracto puro de cal\\u00e9ndula colombiana. 100% org\\u00e1nico. Link en bio para ordenar.\",\n    \"tiktok\": \"Tu piel pidi\\u00e9ndote a gritos que dejes los sulfatos \\u2728 Nueva f\\u00f3rmula Amatu. Pru\\u00e9balo y nota la diferencia en 7 d\\u00edas #skincare #natural #rutinadebelleza\",\n    \"linkedin\": \"En Amatu reafirmamos nuestro compromiso con la ciencia cosm\\u00e9tica sostenible. Presentamos el nuevo desarrollo en biotecnolog\\u00eda vegetal para el cuidado d\\u00e9rmico.\"\n  },\n  \"mode\": \"schedule\",\n  \"publish_at\": \"2026-08-25T18:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{postiz_api_url}}/posts",
              "host": [
                "{{postiz_api_url}}"
              ],
              "path": [
                "posts"
              ]
            }
          }
        },
        {
          "name": "IE-05: Metricool - Fallback de Programación Multicanal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-MC-TOKEN",
                "value": "{{metricool_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Post programado de contingencia v\\u00eda Metricool API\",\n  \"publicationDate\": \"2026-08-25T18:00:00Z\",\n  \"networks\": [\n    \"INSTAGRAM\",\n    \"TIKTOK\"\n  ]\n}"
            },
            "url": {
              "raw": "https://app.metricool.com/api/v1/planner/posts",
              "protocol": "https",
              "host": [
                "app",
                "metricool",
                "com"
              ],
              "path": [
                "api",
                "v1",
                "planner",
                "posts"
              ]
            }
          }
        },
        {
          "name": "IE-08: YouTube Data - Cargar Video / Short",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{youtube_oauth_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"snippet\": {\n    \"title\": \"Biotecnolog\\u00eda en Dermocosm\\u00e9tica | Amatu\",\n    \"description\": \"Conoce los principios activos de nuestra f\\u00f3rmula org\\u00e1nica.\",\n    \"tags\": [\n      \"cosmetica\",\n      \"skincare\",\n      \"biotecnologia\"\n    ],\n    \"categoryId\": \"22\"\n  },\n  \"status\": {\n    \"privacyStatus\": \"public\"\n  }\n}"
            },
            "url": {
              "raw": "https://www.googleapis.com/youtube/v3/videos?part=snippet,status",
              "protocol": "https",
              "host": [
                "www",
                "googleapis",
                "com"
              ],
              "path": [
                "youtube",
                "v3",
                "videos"
              ],
              "query": [
                {
                  "key": "part",
                  "value": "snippet,status"
                }
              ]
            }
          }
        }
      ]
    },
